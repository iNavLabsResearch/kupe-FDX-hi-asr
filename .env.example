# Copy to .env and fill in. Loaded automatically (python-dotenv) by env.py.

# ---- Hugging Face (data/model/run repos + base-model download) ----
HF_TOKEN=hf_xxx
HF_OWNER=anuj-inavlabs          # {owner} in configs/*.yaml repos

# ---- Weights & Biases (auto-disabled if key absent; metrics still print) ----
WANDB_API_KEY=xxx
WANDB_PROJECT=kupe-fdx-hi-asr

# ---- Data-generation LLM (floor-control + domain correction agents) ----
# OpenAI-compatible /chat/completions endpoint.
KUPE_LLM_BASE_URL=https://api.openai.com/v1
KUPE_LLM_API_KEY=sk-xxx
KUPE_LLM_MODEL=gpt-5.6-luna     # data-generation model (as specified)

# ---- Optional config overrides (KUPE_<SECTION>_<KEY>) ----
# KUPE_TRAIN_LR=1e-4
# KUPE_TRAIN_BATCH_SIZE=16
# KUPE_AUDIO_N_CODES=0          # 0 = continuous-only (recommended); >0 = add discrete audio tokens
# KUPE_AUDIO_CHUNK_FRAMES=32    # streaming chunk size in encoder frames (~640ms @50fps)

# Optional: show $ cost of data generation (gpt-5.6-luna price per 1M tokens)
KUPE_LLM_PRICE_IN=
KUPE_LLM_PRICE_OUT=
